# LLM backend: auto (Claude if credentials exist, else offline heuristics) | claude | heuristic
JOURNAL_LLM_BACKEND=auto
ANTHROPIC_API_KEY=
JOURNAL_MODEL=claude-opus-5-5
JOURNAL_EFFORT=high

# Workflow
JOURNAL_HUMAN_APPROVAL=true
JOURNAL_MAX_ROUNDS=2
JOURNAL_MIN_REVIEWERS=3
JOURNAL_MAX_REVIEWERS=6
JOURNAL_ASSIGNMENT_SEED=7

# Persistence: sqlite | memory | postgres
JOURNAL_DATA_DIR=./var
JOURNAL_CHECKPOINTER=sqlite
JOURNAL_POSTGRES_URL=postgresql://journal:journal@localhost:5432/journal

# Tools: local (in-process) | mcp (via the MCP server)
JOURNAL_TOOL_TRANSPORT=local
JOURNAL_MCP_URL=http://localhost:8765/mcp
JOURNAL_LITERATURE_LIVE=false

# Integrations
N8N_WEBHOOK_URL=
JOURNAL_API_KEY=
JOURNAL_DOI_PREFIX=10.5555
